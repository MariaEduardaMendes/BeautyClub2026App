@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container my-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>A Nossa Loja</h2>
        <a class="btn btn-success px-4" asp-page="/Create">Novo Produto</a>
    </div>

    <div class="row justify-content-md-center">
        @foreach (var item in Model.Produtos)
        {
            <div class="card col-3 m-3">
                <img src=@item.ImagemUrl class="p-3" style="border-radius: 25px">
                <div class="card-body">
                    <h5 class="card-title">@item.Nome</h5>
                    <p class="card-text">@item.Descricao</p>
                    <div class="d-flex gap-2">
                        <a class="btn btn-primary" asp-page="/Details" asp-route-id="@item.ProdutoId">Ver mais</a>
                        <a class="btn btn-warning" asp-page="/Edit" asp-route-id="@item.ProdutoId">Editar</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>